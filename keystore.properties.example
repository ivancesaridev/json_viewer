# Copy this file to `keystore.properties` in the repository root and fill in your own values.
#
#   cp keystore.properties.example keystore.properties
#
# `keystore.properties` and every *.jks / *.keystore file are git-ignored: the real signing key must
# never be committed. On CI, set ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS
# and ANDROID_KEY_PASSWORD as secrets instead of using this file.
#
# To create an upload key:
#
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#       -validity 10000 -alias upload

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
