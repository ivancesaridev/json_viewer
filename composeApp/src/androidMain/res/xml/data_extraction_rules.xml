<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 and above.

  See backup_rules.xml: the recent-files store contains content:// URIs whose permission grants are
  tied to this install, so it is excluded from both cloud backup and direct device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recent_files.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recent_files.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
